bin/
node_modules
# Finder metadata. macOS drops these into any directory it browses, so the
# rule is bare (no leading slash) and matches at every depth.
.DS_Store
# Playwright run output from extension/e2e.
test-results/
playwright-report/
# Playwright MCP scratch output, written to the repo root during browser-driven
# UI verification.
.playwright-mcp/
# Verification screenshots land at the repo root during UI work. They are
# throwaway evidence, not artifacts, and the repo is public — an unlucky
# `git add -A` should not publish a snapshot of a logged-in session.
/*.png
/*.jpg
/*.jpeg
.env
# Any .env variant — backups, per-host copies, editor swap files. A bare `.env`
# rule leaves `.env.bak`/`.env.local` untracked-but-committable, which is how
# real API keys get staged by an unlucky `git add -A`. `.env.example` is
# re-included below because it carries no secrets.
.env.*
!.env.example
/data/
.superpowers/

# Browser cookie material — never commit. Cookies.binarycookies is Safari's
# jar for EVERY site, not just YouTube; the .txt forms are Netscape exports
# fed to yt-dlp. Both are live session credentials.
Cookies.binarycookies
*.binarycookies
# Broad on purpose: a narrow "*-cookies.txt" missed yt-cookies-youtube.txt,
# which held live auth cookies as an untracked file.
*cookies*.txt
*cookies*.json

# Local Claude Code settings
.claude/
.agents/

# ship:begin (owned by ship init; the repo's own lines go above the begin marker)
# What the gate and the UI build write into the tree.
coverage/ui/
ui/node_modules/
ui/*.tsbuildinfo
# The UI build the Go binary embeds; .gitkeep stays tracked so go:embed's dir exists in a fresh clone.
backend/web/dist/*
!backend/web/dist/.gitkeep
# ship:end
