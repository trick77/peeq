# peeq configuration. Copy to .env and fill in the values.
# Every BACKEND_* variable the backend reads (see backend/internal/config/config.go)
# is listed below with its real default in a comment.

# --- Core -------------------------------------------------------------------

# Externally reachable base URL. Required in production (OIDC redirect/logout
# URLs are built relative to it); leave empty for dev mode (default "").
BACKEND_PUBLIC_URL=https://peeq.example.com

# HTTP listen address (default ":8080"). Dev auth REQUIRES this to be a
# loopback address (e.g. "127.0.0.1:8080") — the boot check refuses to start
# otherwise.
# BACKEND_ADDR=:8080

# Long random string used to sign session cookies. Required — the process
# refuses to start without it. Generate one with e.g. `openssl rand -hex 32`.
BACKEND_SESSION_SECRET=change-me-to-a-long-random-string

# --- Authentication -----------------------------------------------------
# One of: oidc | dev. No default — the process refuses to start if unset.
BACKEND_AUTH_MODE=oidc

# OIDC block, required when BACKEND_AUTH_MODE=oidc.
BACKEND_OIDC_ISSUER=https://auth.example.com/application/o/peeq/
BACKEND_OIDC_CLIENT_ID=
BACKEND_OIDC_CLIENT_SECRET=
BACKEND_OIDC_REDIRECT_URL=https://peeq.example.com/api/auth/callback
# Optional: where the IdP sends the browser back to after logout (default "").
BACKEND_OIDC_POST_LOGOUT_REDIRECT_URL=https://peeq.example.com/
# Optional: OIDC group name that grants admin (default "", meaning no group
# check — every authenticated user is admin; peeq is single-user by design).
BACKEND_OIDC_ADMIN_GROUP=peeq-admins

# --- Storage ------------------------------------------------------------

# Path to the SQLite database file (default "/data/peeq.db"). Holds settings,
# the job queue, and every video's watch/favorite/tombstone state — back this
# file up, see README.
BACKEND_DB_PATH=/data/peeq.db

# Root directory downloaded media is written to, as <dir>/<channel>/<video>/
# (default "/data/media").
BACKEND_MEDIA_DIR=/data/media

# Writable directory the yt-dlp binary is fetched/self-updated into at
# runtime (default "/data/bin").
BACKEND_YTDLP_DIR=/data/bin

# --- Phase 3: AI (required — peeq will not boot without these) --------

# MiMo chat API endpoint and token for generating summaries and chapters.
BACKEND_MIMO_BASE_URL=http://localhost:8000/v1
BACKEND_MIMO_API_KEY=

# Embeddings API endpoint, model name, and token for vector search.
BACKEND_EMBED_BASE_URL=http://localhost:8001/v1
BACKEND_EMBED_API_KEY=
BACKEND_EMBED_MODEL=text-embedding-3-small
# Vector dimension (fixed at DB DDL time; changing it requires recreating
# the database, see README for details).
BACKEND_EMBED_DIM=1536

# Default subtitle/caption language for downloads if none is already present.
BACKEND_DEFAULT_SUB_LANG=en

# --- Logging --------------------------------------------------------------

# Log verbosity: debug | info | warn | error (default "info").
# BACKEND_LOG_LEVEL=info

# --- Local development without OIDC ----------------------------------------
# Enables an unauthenticated auto-login as a fixed local admin user. The
# process refuses to start in this mode unless BACKEND_ADDR/BACKEND_PUBLIC_URL are
# loopback-only, so this can never accidentally become reachable over the
# network.
# BACKEND_AUTH_MODE=dev
# BACKEND_ADDR=127.0.0.1:8080
# BACKEND_PUBLIC_URL=http://localhost:8080

# Dev auto-login identity overrides (defaults shown; only read in dev mode).
# BACKEND_DEV_USER_SUBJECT=dev-admin
# BACKEND_DEV_USER_USERNAME=dev
# BACKEND_DEV_USER_EMAIL=dev@example.local
# BACKEND_DEV_USER_NAME=Dev Admin

# DEV-ONLY escape hatch (default false): lets yt-dlp run WITHOUT a cookie.
# Exists because on current YouTube, authenticated yt-dlp requests get served
# no usable formats while anonymous ones work fine — so local testing needs a
# way around peeq's normal "no YouTube call without a cookie" invariant. A
# present-but-expired/blocked cookie STILL fails even with this on (that's a
# real bad-cookie signal, not an absence). The 20s+ throttle floor still
# applies to anonymous calls exactly as before.
# REJECTED at boot unless BACKEND_AUTH_MODE=dev (which is itself loopback-only)
# — setting this to true with BACKEND_AUTH_MODE=oidc is a hard startup error,
# never a silent behavior change. Never enable this in production.
# BACKEND_ALLOW_ANONYMOUS_YOUTUBE=true
