# peeq configuration. Copy to .env and fill in the values.
# Every PEEQ_* variable the backend reads (see backend/internal/config/config.go)
# is listed below with its real default in a comment.

# --- Core -------------------------------------------------------------------

# Externally reachable base URL. Required in production (OIDC redirect/logout
# URLs are built relative to it); leave empty for dev mode (default "").
PEEQ_PUBLIC_URL=https://peeq.example.com

# HTTP listen address (default ":8080"). Dev auth REQUIRES this to be a
# loopback address (e.g. "127.0.0.1:8080") — the boot check refuses to start
# otherwise.
# PEEQ_ADDR=:8080

# Long random string used to sign session cookies. Required — the process
# refuses to start without it. Generate one with e.g. `openssl rand -hex 32`.
PEEQ_SESSION_SECRET=change-me-to-a-long-random-string

# --- Authentication -----------------------------------------------------
# One of: oidc | dev. No default — the process refuses to start if unset.
PEEQ_AUTH_MODE=oidc

# OIDC block, required when PEEQ_AUTH_MODE=oidc.
PEEQ_OIDC_ISSUER=https://auth.example.com/application/o/peeq/
PEEQ_OIDC_CLIENT_ID=
PEEQ_OIDC_CLIENT_SECRET=
PEEQ_OIDC_REDIRECT_URL=https://peeq.example.com/api/auth/callback
# Optional: where the IdP sends the browser back to after logout (default "").
PEEQ_OIDC_POST_LOGOUT_REDIRECT_URL=https://peeq.example.com/
# Optional: OIDC group name that grants admin (default "", meaning no group
# check — every authenticated user is admin; peeq is single-user by design).
PEEQ_OIDC_ADMIN_GROUP=peeq-admins

# --- Storage ------------------------------------------------------------

# Path to the SQLite database file (default "/data/peeq.db"). Holds settings,
# the job queue, and every video's watch/favorite/tombstone state — back this
# file up, see README.
PEEQ_DB_PATH=/data/peeq.db

# Root directory downloaded media is written to, as <dir>/<channel>/<video>/
# (default "/data/media").
PEEQ_MEDIA_DIR=/data/media

# Writable directory the yt-dlp binary is fetched/self-updated into at
# runtime (default "/data/bin").
PEEQ_YTDLP_DIR=/data/bin

# --- Logging --------------------------------------------------------------

# Log verbosity: debug | info | warn | error (default "info").
# PEEQ_LOG_LEVEL=info

# --- Local development without OIDC ----------------------------------------
# Enables an unauthenticated auto-login as a fixed local admin user. The
# process refuses to start in this mode unless PEEQ_ADDR/PEEQ_PUBLIC_URL are
# loopback-only, so this can never accidentally become reachable over the
# network.
# PEEQ_AUTH_MODE=dev
# PEEQ_ADDR=127.0.0.1:8080
# PEEQ_PUBLIC_URL=http://localhost:8080

# Dev auto-login identity overrides (defaults shown; only read in dev mode).
# PEEQ_DEV_USER_SUBJECT=dev-admin
# PEEQ_DEV_USER_USERNAME=dev
# PEEQ_DEV_USER_EMAIL=dev@example.local
# PEEQ_DEV_USER_NAME=Dev Admin
