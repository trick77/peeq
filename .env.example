# Public URL and session secret
VARK_PUBLIC_URL=https://vark.example.com
VARK_SESSION_SECRET=change-me-to-a-long-random-string

# Authentication
VARK_AUTH_MODE=oidc
VARK_OIDC_ISSUER=https://auth.example.com/application/o/vark/
VARK_OIDC_CLIENT_ID=
VARK_OIDC_CLIENT_SECRET=
VARK_OIDC_REDIRECT_URL=https://vark.example.com/api/auth/callback
VARK_OIDC_POST_LOGOUT_REDIRECT_URL=https://vark.example.com/
VARK_OIDC_ADMIN_GROUP=vark-admins

# Storage
VARK_DB_PATH=/data/vark.db
VARK_MEDIA_DIR=/data/media
# Writable directory yt-dlp is fetched/self-updated into at runtime.
VARK_YTDLP_DIR=/data/bin

# Log verbosity: debug | info | warn | error (default info).
# VARK_LOG_LEVEL=info

# Local development without OIDC:
# VARK_AUTH_MODE=dev
# VARK_ADDR=127.0.0.1:8080
# VARK_PUBLIC_URL=http://localhost:8080
