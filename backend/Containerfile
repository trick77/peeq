# syntax=docker/dockerfile:1

# --- Stage 1: build the SPA --- (CI's node-version follows this major: ship init renders it from here)
FROM node:26-alpine AS ui
WORKDIR /app/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

# --- Stage 2: build the Go API binary (pure-Go, no cgo) with the embedded SPA ---
FROM golang:1.27-alpine AS build
# ship release passes the release version.
ARG VERSION=dev
WORKDIR /app/backend
COPY backend/go.mod backend/go.sum* ./
RUN go mod download
COPY backend/ ./
# The real Vite bundle into backend/web/dist (the context leaves the host's out,
# .dockerignore), so //go:embed all:dist bakes the production UI into the
# binary. ui/vite.config.ts builds straight to ../backend/web/dist (not the
# Vite-default ui/dist), so from the ui stage's WORKDIR that lands at
# /app/backend/web/dist.
COPY --from=ui /app/backend/web/dist ./web/dist
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/trick77/ship/kit/version.Version=${VERSION}" -o /out/peeq ./cmd/peeq

# --- Stage 3: unpack the self-contained yt-dlp build ---
#
# The unpacked yt-dlp_linux.zip, not the plain "yt-dlp" zipapp and not the
# one-file "yt-dlp_linux":
#   - the zipapp runs on a system python without curl_cffi, so it cannot
#     impersonate a browser, and YouTube answered some of its caption downloads
#     with HTTP 429 on every attempt;
#   - the one-file build unpacks ~100MB into TMPDIR on every run, which the
#     read-only container's noexec /tmp tmpfs refuses.
# Same asset the self-update fetches (ytdlp.releaseFor), so the image and
# /data/bin always run the same kind of build.
#
# "latest" is resolved when this layer is BUILT, and the layer cache then keeps
# that answer for as long as the instruction text is unchanged — which was
# forever. VERSION is the cache key: every release has a new one, so every
# release image fetches the yt-dlp of its day. (peeq also updates yt-dlp at
# runtime into its data directory; this is the copy a fresh container starts
# with.)
FROM debian:13-slim AS ytdlp
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*
ARG VERSION=dev
ARG TARGETARCH
RUN echo "yt-dlp layer: ${VERSION}" \
    && case "${TARGETARCH}" in \
         amd64) exe=yt-dlp_linux ;; \
         arm64) exe=yt-dlp_linux_aarch64 ;; \
         arm) exe=yt-dlp_linux_armv7l ;; \
         *) echo "no self-contained yt-dlp build for ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/yt-dlp.zip "https://github.com/yt-dlp/yt-dlp/releases/latest/download/${exe}.zip" \
    && unzip -q /tmp/yt-dlp.zip -d /opt/yt-dlp \
    && rm /tmp/yt-dlp.zip \
    && chmod -R a+rX /opt/yt-dlp \
    && ln -s "/opt/yt-dlp/${exe}" /opt/yt-dlp/yt-dlp

# --- Stage 4: minimal runtime ---
#
# Deviation from loom: loom's runtime is gcr.io/distroless/static-debian12, a
# scratch-like image with no shell, no package manager, and no dynamic libc —
# it cannot host ffmpeg or the yt-dlp build (both need a real userland and
# glibc). peeq shells out to ffmpeg and yt-dlp for every download, so it uses
# debian:13-slim (glibc, apt) and installs both directly.
FROM debian:13-slim AS runtime
# upgrade: the base image lags Debian's security fixes, and the release's trivy
# scan fails on any fixed HIGH or CRITICAL finding.
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*
# yt-dlp on PATH. /data/bin (BACKEND_YTDLP_DIR) is a separate, writable volume
# the self-update installs newer builds into without rebuilding the image; this
# is the copy used until then. The build fails if Chrome impersonation is
# unavailable, so the caption 429s cannot come back silently.
COPY --from=ytdlp /opt/yt-dlp /opt/yt-dlp
RUN ln -s /opt/yt-dlp/yt-dlp /usr/local/bin/yt-dlp \
    && yt-dlp --list-impersonate-targets | grep -i '^chrome' | grep -vq unavailable
# yt-dlp must execute YouTube's player JavaScript to solve the sig and n
# challenges. Without a runtime it falls back to a deprecated Python
# reimplementation where formats silently disappear from the list and
# transfers get throttled. deno is the only runtime yt-dlp enables by
# default, so it is auto-detected on PATH and no --js-runtimes flag is
# needed anywhere in the Go code.
#
# Pinned by DIGEST, not just tag: this is the one binary in the image whose
# job is executing code a third party controls, so the bytes must be exactly
# the ones reviewed. To bump, change the tag AND the digest together.
# yt-dlp-ejs (the JS that drives the runtime) is already bundled inside the
# self-contained yt-dlp build above, so nothing is fetched at run time.
COPY --from=denoland/deno:bin-2.9.3@sha256:eb93e70bd53efec4be113d9974107840756551bc1a59a8258892d7bbe5fb4ab0 \
     /deno /usr/local/bin/deno
# Fail the build loudly if the runtime cannot execute, rather than shipping
# an image that silently degrades extraction in production.
RUN deno --version
COPY --from=build /out/peeq /usr/local/bin/peeq
# Non-root, the uid compose runs it as (user: "1000:1000"), so the image's own
# default never runs ffmpeg or yt-dlp as root either. /data is its own, for a
# run that mounts no volume there; HOME and TMPDIR are /tmp, as compose sets
# them, because yt-dlp writes its cache and the cookie temp file there and a
# read-only rootfs has no other writable place.
RUN useradd --uid 1000 --user-group --no-create-home --shell /usr/sbin/nologin peeq \
    && mkdir /data && chown 1000:1000 /data
ENV HOME=/tmp TMPDIR=/tmp
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/peeq"]
