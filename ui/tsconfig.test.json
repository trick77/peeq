{
  // Everything under src, tests included. Node types are available here
  // because src/enumsync.test.ts reads the Go category enum from disk to guard
  // against Go<->TS enum drift; tsconfig.app.json keeps them out of
  // application code.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}
